---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div>
    <div class="relative h-full">
      <img
        width="444"
        height="314"
        class="lg:hidden max-w-md mx-auto block mb-32"
        src="/JMB-mobile.svg"
        alt="Jack Murray-Brown"
      />
      <img
        width="1192"
        height="460"
        class="hidden lg:block xl:-mb-16 2xl:-mb-72 max-w-screen-xl mx-auto"
        src="/JMB.svg"
        alt="Jack Murray-Brown"
      />
      <div
        class="mx-auto max-w-md -mt-12 lg:-mt-40 border-me p-4 mb-16 relative"
        style="transform: rotate(3deg);"
      >
        <h1 class="h1-index">Hi, I'm Jack and welcome to my website.</h1>
        <p class="h1-index mb-4">
          I'm a developer, artist and radio enthusiast, focussed on
          accessibility, sustainability and community engaged projects.
          Currently based in Berlin.
        </p>
        <figure class="mb-0 relative">
          <img
            height="414"
            width="273"
            src="/images/homepage/antivirus-pichi_kk6r4v.jpg"
            alt="Jack Murray-Brown just before a swim in the North Sea"
            loading="lazy"
          />
          <figcaption>Me just before a swim in the North Sea</figcaption>
        </figure>
      </div>
    </div>

    <h2 class="italic mb-4">Seriously selected work!</h2>
    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8 mb-24 lg:mb-0 md:gap-x-6 md:gap-y-12">

      <article>
        <a
          href="https://refugeworldwide.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #fd8d7e"
        >
          <div class="relative">
            <span class="absolute top-4 left-4 border-black border p-2" style="background-color: #fd8d7e">Current</span>
            <img
              height="500"
              width="500"
              src="/images/homepage/Screenshot_2023-05-18_at_17.57.07_qdk8a7.png"
              alt="Refuge Worldwide website showing a radio show listing page"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="m-0">
              Web development, design and software systems consultancy for
              Refuge Worldwide, a community radio station based in Berlin.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="https://toolkitty.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #C5E2ED"
        >
          <div class="relative">
            <span class="absolute top-4 left-4 border-black border p-2" style="background-color: #C5E2ED">Current</span>
            <img
              height="500"
              width="500"
              src="/images/homepage/Screenshot_2025-04-14_at_12.30.31-pichi_tl2tu4.jpg"
              alt="Toolkitty app interface showing a collective coordination dashboard"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="m-0">
              Toolkitty — P2P coordination app for collectives, organisers and venues.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="https://reader.futureartecosystems.org/briefing/fae4"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #E3D6F4"
        >
          <div class="relative">
            <img
              height="500"
              width="500"
              src="/images/homepage/fae4_lg3ryn.jpg"
              alt="Serpentine Galleries Future Art Ecosystems 4 publication cover"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="m-0">
              Serpentine Galleries — Future Art Ecosystems 4: Art × Public AI
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="https://www.are.na/jack-murray-brown/community-archives-and-shared-infrastructures"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #98DC89"
        >
          <div class="relative">
            <img
              height="500"
              width="500"
              src="/images/homepage/community_archives_svzx3d.jpg"
              alt="Community archives workshop materials and notes"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="m-0">
              Community archives and shared infrastructures workshop for ICRN.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="https://metagov.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #99B6BA"
        >
          <div class="relative">
            <img
              height="500"
              width="500"
              src="/images/homepage/metagov_logo_jrm89m.png"
              alt="Metagov logo — an interdisciplinary research collective"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="m-0">
              Web development for Metagov.org, an interdisciplinary research
              collective and Policykit, an engine for building governance in
              online communities.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="https://ra.co/exchange/644"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #CFB687"
        >
          <img
            height="500"
            width="500"
            src="https://imgproxy.ra.co/_/quality:66/w:1200/rt:fill/aHR0cHM6Ly9zdGF0aWMucmEuY28vaW1hZ2VzL3BvZGNhc3QvZXhjaGFuZ2UvZXg2NDQtY292ZXIuanBn"
            alt="EX.644 Source Material: Scottish Music's Mythic Imaginary exchange cover art"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">
              Delighted to be on RA Exchange 644 discussing folklore, radio and
              worldbuilding through the web and visuals.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a href="/work/norbergfestival-radio" class="border-me homepage-item" style="background-color: #8BD3E6">
          <img
            width="380"
            height="448"
            src="/images/homepage/R1-08651-0001_imxtor.jpg"
            alt="A person plays guitar inside a transparent bubble with sun light glistening down"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">
              Co-ordinating the radio station at the 21st edition of Norbergfestival.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a href="/work/guts" class="border-me homepage-item" style="background-color: #F6D4FE">
          <img
            width="380"
            height="428"
            src="/images/homepage/GUTS-1622_t4ktnx.jpg"
            alt="TV with 3D wobbly text reading GUTS is attached to a steel truss"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">
              Visuals and website for GUTS, a Glasgow based club night with a
              focus on transparency.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a href="/work/fruitful-fm" class="border-me homepage-item" style="background-color: #91CC8F">
          <img
            width="380"
            height="342"
            src="/images/homepage/TERRA_INCOGNITA-5937_vcyz6z.jpg"
            alt="A blurred plum is held in front of a greenhouse with vinyl reading Fruitful.FM visible"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">
              A radio station housed inside a greenhouse. Flipping the
              traditional 'dead' and hidden space of a radio studio on its head.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a href="/work/freeform-radio-directory" class="border-me homepage-item" style="background-color: #E69F8B">
          <img
            width="380"
            height="214"
            src="/images/homepage/freeform-1-pichi-1_aepygs.jpg"
            alt="Website homepage for Freeform Radio Directory in a mocked-up browser with a red shadow on a pixelated image"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">Website showcasing the best in world wide wadio</h3>
          </div>
        </a>
      </article>

      <article>
        <a href="/work/come-in-peace" class="border-me homepage-item" style="background-color: #54A589">
          <img
            width="380"
            height="253"
            src="/images/homepage/2H6A6270-pichi_vdlz5r.jpg"
            alt="CRT TV shows text Peace in a graffiti font in the dark"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">Visuals for Interplanatary Criminal</h3>
          </div>
        </a>
      </article>

      <article>
        <a href="/work/aerial-community-radio" class="border-me homepage-item" style="background-color: #9e96c4">
          <img
            width="380"
            height="217"
            src="/images/homepage/Screenshot_2020-10-30_at_00.28.38-pichi_y2vwxp.jpg"
            alt="Aerial website homepage — skewed elements and text sit on top of an image of the North Sea"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">Real community radio hours</h3>
          </div>
        </a>
      </article>

    </div>
  </div>
</Layout>
