---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

// Import homepage images
import jackSwimImg from "../../public/images/homepage/jack-swim.jpg";
import refugeImg from "../../public/images/homepage/refuge.png";
import toolkittyImg from "../../public/images/homepage/toolkitty.jpg";
import fae4Img from "../../public/images/homepage/fae4.jpg";
import communityArchivesImg from "../../public/images/homepage/community-archives.jpg";
import metagovImg from "../../public/images/homepage/metagov.png";
import ex644Img from "../../public/images/homepage/ex-644.jpg";
import norbergImg from "../../public/images/homepage/norberg.jpg";
import gutsImg from "../../public/images/homepage/guts.jpg";
import fruitfulImg from "../../public/images/homepage/fruitful.jpg";
import freeformImg from "../../public/images/homepage/freeform.jpg";
import comeInPeaceImg from "../../public/images/homepage/come-in-peace.jpg";
import aerialImg from "../../public/images/homepage/aerial.jpg";
---

<Layout>
  <div>
    <div class="relative h-full">
      <img
        width="444"
        height="314"
        class="lg:hidden max-w-md mx-auto block mb-32"
        src="/JMB-mobile.svg"
        alt="Jack Murray-Brown"
      />
      <img
        width="1192"
        height="460"
        class="hidden lg:block xl:-mb-16 2xl:-mb-72 max-w-full mx-auto"
        src="/JMB.svg"
        alt="Jack Murray-Brown"
      />
      <div
        class="mx-auto max-w-md -mt-12 lg:-mt-40 border-me p-4 mb-16 relative"
        style="transform: rotate(3deg);"
      >
        <h1 class="h1-index">Hi, I'm Jack and welcome to my website.</h1>
        <p class="h1-index mb-4">
          I'm a developer, artist and radio enthusiast, focussed on
          accessibility, sustainability and community engaged projects.
          Currently based in Berlin.
        </p>
        <figure class="mb-0 relative">
          <Image
            src={jackSwimImg}
            alt="Jack Murray-Brown just before a swim in the North Sea"
            loading="lazy"
          />
          <figcaption>Me just before a swim in the North Sea</figcaption>
        </figure>
      </div>
    </div>

    <h2 class="italic mb-4">Seriously selected work!</h2>
    <div
      class="grid md:grid-cols-2 xl:grid-cols-3 gap-8 mb-24 lg:mb-0 md:gap-x-6 md:gap-y-12"
    >
      <article>
        <a
          href="https://refugeworldwide.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #fd8d7e"
        >
          <div class="relative">
            <span
              class="absolute top-4 left-4 border-black border p-2"
              style="background-color: #fd8d7e">Current</span
            >
            <Image
              src={refugeImg}
              alt="Refuge Worldwide website showing a radio show listing page"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="m-0">
              Web development, design and software systems consultancy for
              Refuge Worldwide, a community radio station based in Berlin.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="https://toolkitty.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #C5E2ED"
        >
          <div class="relative">
            <span
              class="absolute top-4 left-4 border-black border p-2"
              style="background-color: #C5E2ED">Current</span
            >
            <Image
              src={toolkittyImg}
              alt="Toolkitty app interface showing a collective coordination dashboard"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="m-0">
              Toolkitty — P2P coordination app for collectives, organisers and
              venues.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="https://reader.futureartecosystems.org/briefing/fae4"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #E3D6F4"
        >
          <div class="relative">
            <Image
              src={fae4Img}
              alt="Serpentine Galleries Future Art Ecosystems 4 publication cover"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="m-0">
              Serpentine Galleries — Future Art Ecosystems 4: Art × Public AI
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="https://www.are.na/jack-murray-brown/community-archives-and-shared-infrastructures"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #98DC89"
        >
          <div class="relative">
            <Image
              src={communityArchivesImg}
              alt="Community archives workshop materials and notes"
              loading="lazy"
            />
          </div>
          <div class="p-4">
            <h3 class="m-0">
              Community archives and shared infrastructures workshop for ICRN.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="https://metagov.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #99B6BA"
        >
          <div class="relative">
            <Image
              src={metagovImg}
              alt="Metagov logo — an interdisciplinary research collective"
              loading="lazy"
              class="w-full"
            />
          </div>
          <div class="p-4">
            <h3 class="m-0">
              Web development for Metagov.org, an interdisciplinary research
              collective and Policykit, an engine for building governance in
              online communities.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="https://ra.co/exchange/644"
          target="_blank"
          rel="noopener noreferrer"
          class="border-me homepage-item"
          style="background-color: #CFB687"
        >
          <Image
            src={ex644Img}
            alt="EX.644 Source Material: Scottish Music's Mythic Imaginary exchange cover art"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">
              Delighted to be on RA Exchange 644 discussing folklore, radio and
              worldbuilding through the web and visuals.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="/work/norbergfestival-radio"
          class="border-me homepage-item"
          style="background-color: #8BD3E6"
        >
          <Image
            src={norbergImg}
            alt="A person plays guitar inside a transparent bubble with sun light glistening down"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">
              Co-ordinating the radio station at the 21st edition of
              Norbergfestival.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="/work/guts"
          class="border-me homepage-item"
          style="background-color: #F6D4FE"
        >
          <Image
            src={gutsImg}
            alt="TV with 3D wobbly text reading GUTS is attached to a steel truss"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">
              Visuals and website for GUTS, a Glasgow based club night with a
              focus on transparency.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="/work/fruitful-fm"
          class="border-me homepage-item"
          style="background-color: #91CC8F"
        >
          <Image
            src={fruitfulImg}
            alt="A blurred plum is held in front of a greenhouse with vinyl reading Fruitful.FM visible"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">
              A radio station housed inside a greenhouse. Flipping the
              traditional 'dead' and hidden space of a radio studio on its head.
            </h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="/work/freeform-radio-directory"
          class="border-me homepage-item"
          style="background-color: #E69F8B"
        >
          <Image
            src={freeformImg}
            alt="Website homepage for Freeform Radio Directory in a mocked-up browser with a red shadow on a pixelated image"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">Website showcasing the best in world wide wadio</h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="/work/come-in-peace"
          class="border-me homepage-item"
          style="background-color: #54A589"
        >
          <Image
            src={comeInPeaceImg}
            alt="CRT TV shows text Peace in a graffiti font in the dark"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">Visuals for Interplanatary Criminal</h3>
          </div>
        </a>
      </article>

      <article>
        <a
          href="/work/aerial-community-radio"
          class="border-me homepage-item"
          style="background-color: #9e96c4"
        >
          <Image
            src={aerialImg}
            alt="Aerial website homepage — skewed elements and text sit on top of an image of the North Sea"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="m-0">Real community radio hours</h3>
          </div>
        </a>
      </article>
    </div>
  </div>
</Layout>
