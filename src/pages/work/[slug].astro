---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("work");
  return projects.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, link, tags, display_project_date, media } =
  entry.data;

const firstImage = media.find((m) => m.image)?.image;
---

<Layout title={title} description={description} ogImage={firstImage?.src}>
  <div class="max-w-4xl">
    <section class="mb-12" aria-label="Title and basic info">
      <div>
        {
          display_project_date && (
            <span class="italic inline mr-2">{display_project_date}</span>
          )
        }
        {
          tags.length > 0 && (
            <ul class="inline p-0 project-tags" aria-label="Project tags">
              {tags.map((tag) => (
                <li class="inline pill rounded-full px-4 mr-2">{tag}</li>
              ))}
            </ul>
          )
        }
        <h1 class="mb-4 mt-2">{title}</h1>
        <h2 class="mb-8 max-w-prose">{description}</h2>

        <details class="border-me p-4 mb-8 max-w-prose">
          <summary>Info</summary>
          <div class="prose">
            <Content />
          </div>
        </details>

        {
          link && (
            <a
              class="mb-8 block max-w-prose"
              href={link}
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit {title}
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          )
        }
      </div>
    </section>

    <section aria-label="Project media">
      {
        media.map((item) => {
          if (item.image) {
            return (
              <figure class="mb-10">
                <div class="img-wrap">
                  <Image
                    src={item.image}
                    alt={item.alt ?? ""}
                    loading="lazy"
                    sizes="(min-width: 1536px) 916px, 100vw"
                  />
                </div>
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            );
          }
          if (item.gif) {
            return (
              <figure class="mb-10">
                <div class="img-wrap">
                  <img
                    src={item.gif.src}
                    alt={item.alt ?? ""}
                    loading="lazy"
                    width={item.gif.width}
                    height={item.gif.height}
                  />
                </div>
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            );
          }
          if (item.video) {
            return (
              <div class="mb-10">
                <video controls preload="none">
                  <source src={item.video} />
                  Your browser does not support the video element.
                </video>
                {item.caption && <span class="figcaption">{item.caption}</span>}
              </div>
            );
          }
          if (item.embed) {
            return (
              <div class="mb-10">
                <div class="vid-container" set:html={item.embed} />
                {item.caption && <span class="figcaption">{item.caption}</span>}
              </div>
            );
          }
          return null;
        })
      }
    </section>
  </div>
</Layout>

<script>
  document.querySelectorAll(".img-wrap").forEach((wrap) => {
    const img = wrap.querySelector("img");
    if (!img) return;
    if (img.complete) {
      wrap.classList.add("loaded");
    } else {
      img.addEventListener("load", () => wrap.classList.add("loaded"), {
        once: true,
      });
    }
  });
</script>
