---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const pageTitle = title ? `${title} | Jack Murray-Brown` : 'Jack Murray-Brown';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? "Jack Murray-Brown — developer, artist and radio enthusiast focused on accessibility, sustainability and community engaged projects."} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:title" content={pageTitle} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="grid site-layout-grid gap-4">
      <Header />
      <main id="main-content" class="lg:py-8 2xl:py-12">
        <slot />
        <Footer />
      </main>
    </div>
  </body>
</html>
